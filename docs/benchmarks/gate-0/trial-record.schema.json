{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hiimomagh.github.io/Jarbou3i_Model/schema/gate0-trial-record-v1.json",
  "title": "Jarbou3i Gate 0 Human Benchmark Trial",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "trial_id",
    "case_id",
    "case_version",
    "script_version",
    "lens",
    "repository_commit",
    "participant",
    "started_at",
    "ended_at",
    "active_seconds",
    "status",
    "task_results",
    "events",
    "seed_findings",
    "comprehension",
    "participant_explanations",
    "observer_inferences",
    "proposed_responses",
    "data_quality"
  ],
  "properties": {
    "format": {
      "const": "jarbou3i-gate0-trial-v1"
    },
    "trial_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "enum": [
        "gate0-strategic-v1",
        "gate0-biopolitical-v1"
      ]
    },
    "case_version": {
      "const": "1.0.0"
    },
    "script_version": {
      "const": "1.0.0"
    },
    "lens": {
      "enum": [
        "strategic",
        "biopolitical"
      ]
    },
    "repository_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "deployed_url": {
      "type": "string"
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anonymous_id",
        "experience_level",
        "locale"
      ],
      "properties": {
        "anonymous_id": {
          "type": "string",
          "minLength": 1
        },
        "experience_level": {
          "enum": [
            "first_time",
            "intermediate",
            "expert"
          ]
        },
        "locale": {
          "enum": [
            "en",
            "ar",
            "fr"
          ]
        }
      }
    },
    "started_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*(?:Z|[+-]\\d{2}:\\d{2})$"
    },
    "ended_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*(?:Z|[+-]\\d{2}:\\d{2})$"
    },
    "active_seconds": {
      "type": "number",
      "minimum": 0
    },
    "status": {
      "enum": [
        "complete",
        "abandoned",
        "invalidated"
      ]
    },
    "task_results": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/taskResult"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "seed_findings": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/seedFinding"
      }
    },
    "comprehension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence_state",
        "verification_state",
        "publication_state",
        "recovery_state"
      ],
      "properties": {
        "confidence_state": {
          "$ref": "#/$defs/comprehensionResult"
        },
        "verification_state": {
          "$ref": "#/$defs/comprehensionResult"
        },
        "publication_state": {
          "$ref": "#/$defs/comprehensionResult"
        },
        "recovery_state": {
          "$ref": "#/$defs/comprehensionResult"
        }
      }
    },
    "participant_explanations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attributedNote"
      }
    },
    "observer_inferences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inference"
      }
    },
    "proposed_responses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proposedResponse"
      }
    },
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recording_available",
        "timestamps_complete",
        "script_deviation",
        "invalidation_reason"
      ],
      "properties": {
        "recording_available": {
          "type": "boolean"
        },
        "timestamps_complete": {
          "type": "boolean"
        },
        "script_deviation": {
          "type": "string"
        },
        "invalidation_reason": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*(?:Z|[+-]\\d{2}:\\d{2})$"
    },
    "taskResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "started_at",
        "ended_at",
        "status",
        "notes"
      ],
      "properties": {
        "task_id": {
          "enum": [
            "T0",
            "T1",
            "T2",
            "T3",
            "T4",
            "T5",
            "T6",
            "T7"
          ]
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "ended_at": {
          "$ref": "#/$defs/timestamp"
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "failed",
            "skipped"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "timestamp",
        "type",
        "task_id",
        "location",
        "observation"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "$ref": "#/$defs/timestamp"
        },
        "type": {
          "enum": [
            "navigation_reversal",
            "provenance_search_start",
            "provenance_search_end",
            "duplicate_entry",
            "import_rejection",
            "import_correction",
            "unsupported_claim_detected",
            "broken_locator_detected",
            "recovery_attempt",
            "recovery_success",
            "clarification_request",
            "publication_state_error",
            "observer_note"
          ]
        },
        "task_id": {
          "enum": [
            "T0",
            "T1",
            "T2",
            "T3",
            "T4",
            "T5",
            "T6",
            "T7",
            "INTERVIEW"
          ]
        },
        "location": {
          "type": "string"
        },
        "observation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "seedFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed_id",
        "detected",
        "corrected",
        "first_detected_at",
        "disposition"
      ],
      "properties": {
        "seed_id": {
          "type": "string",
          "minLength": 1
        },
        "detected": {
          "type": "boolean"
        },
        "corrected": {
          "type": "boolean"
        },
        "first_detected_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "disposition": {
          "type": "string"
        }
      }
    },
    "comprehensionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rating",
        "answer"
      ],
      "properties": {
        "rating": {
          "enum": [
            "correct",
            "partial",
            "incorrect",
            "not_answered"
          ]
        },
        "answer": {
          "type": "string"
        }
      }
    },
    "attributedNote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note_id",
        "text"
      ],
      "properties": {
        "note_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inference_id",
        "observation_ids",
        "claim",
        "confidence",
        "competing_explanation",
        "disproven_if"
      ],
      "properties": {
        "inference_id": {
          "type": "string",
          "minLength": 1
        },
        "observation_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "competing_explanation": {
          "type": "string",
          "minLength": 1
        },
        "disproven_if": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "proposedResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "response_id",
        "inference_ids",
        "proposal",
        "expected_outcome",
        "falsifier"
      ],
      "properties": {
        "response_id": {
          "type": "string",
          "minLength": 1
        },
        "inference_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "proposal": {
          "type": "string",
          "minLength": 1
        },
        "expected_outcome": {
          "type": "string",
          "minLength": 1
        },
        "falsifier": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
